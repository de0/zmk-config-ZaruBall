//#include <dt-bindings/zmk/mouse.h>

#include <behaviors/rgbled_widget.dtsi>
#include <input/processors.dtsi>
#include <dt-bindings/zmk/input_transform.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define BASE     0
#define MOUSE    1
#define LOWER    2
#define RAISE    3
#define ADJUST   4
#define SCROLL   2

// スクロール量の設定

#define ZMK_POINTING_DEFAULT_SCRL_VAL 100

&trackball_listener {
    input-processors = <
                         &zip_xy_transform (INPUT_TRANSFORM_XY_SWAP | INPUT_TRANSFORM_Y_INVERT | INPUT_TRANSFORM_X_INVERT)
                         &zip_temp_layer MOUSE 500
    >;

    scroller {
        layers = <SCROLL>;
        input-processors = <
                            &zip_xy_transform (INPUT_TRANSFORM_XY_SWAP | INPUT_TRANSFORM_X_INVERT)
                            &zip_xy_scaler 1 20
                            &zip_xy_to_scroll_mapper
        >;
    };
};

/ {
    conditional_layers {
        compatible = "zmk,conditional-layers";

        tri_layer {
            if-layers = <1 3>;
            then-layer = <4>;
        };
    };
};

/ {
    behaviors {
        // スクロール用のbehaviorの設定

        scroll_down_up: behavior_sensor_rotate_mouse_wheel_down_up {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <20>; // スクロールのタップ時間
        };

        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mt LALT LANG2>, <&mo 0>, <&mo 3>;
        };

        td1: tap_dance_1 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&mt RCTL LANG1>, <&mo 0>, <&mo 3>;
        };

        // Customed Hold-Tap for SandS

        SandS: SandS {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-unless-interrupted";
            tapping-term-ms = <500>;
            quick-tap-ms = <500>;
            bindings = <&kp>, <&kp>;

            display-name = "SandS";
        };
    };
};

&sl { release-after-ms = <250>; }; // time needed for double click (for mkp_exit_AML)
/ {
    macros {
        // When in AML, move to default layer when key (except mouse button) pressed

        to_layer_0: to_layer_0 {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&tog 3 &macro_param_1to1 &kp MACRO_PLACEHOLDER>;
            label = "TO_layer_0";
        };

        // When LCLK pressed, exit AML (after 250ms cause by sticky layer

        mkp_exit_AML: mkp_exit_AML {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings =
                <&macro_press>,
                <&macro_param_1to1 &mkp MACRO_PLACEHOLDER>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&macro_param_1to1 &mkp MACRO_PLACEHOLDER>,
                <&macro_tap>,
                <&sl 3>;

            label = "MKP_EXIT_AML";
        };
    };
};

/ {
    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            sensor-bindings = <&inc_dec_kp C_VOLUME_DOWN C_VOLUME_UP>;
            bindings = <
&kp NUMBER_1    &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6                  &kp KP_N7     &kp KP_N8  &kp KP_N9   &kp KP_DIVIDE                         &kp NUMBER_7  &kp N8  &kp N9     &kp NUMBER_0  &kp MINUS  &kp EQUAL
&kp TAB         &kp Q         &kp W         &kp E         &kp R         &kp T                         &kp KP_N4     &kp KP_N5  &kp KP_N6   &kp KP_MULTIPLY                       &kp Y         &kp U   &kp I      &kp O         &kp P      &kp EQUAL
&kp BACKSPACE   &kp A         &kp S         &kp D         &kp F         &kp G         &kp LEFT_GUI    &kp KP_N1     &kp KP_N2  &kp KP_N3   &kp KP_MINUS       &kp LC(NUMBER_1)   &kp H         &kp J   &kp K      &kp L         &kp SEMI   &kp SINGLE_QUOTE
&kp RIGHT       &kp LSHFT     &kp Z         &kp X         &kp C         &kp V         &kp ENTER       &kp KP_ENTER  &kp KP_N0  &kp KP_DOT  &kp KP_PLUS        &kp RIGHT_BRACKET  &kp N         &kp M   &kp COMMA  &kp DOT       &kp FSLH   &kp INTERNATIONAL_1
&kp LEFT_ARROW  &trans                      &kp LALT      &kp LCTRL     &lt 3 SPACE   &kp B                                                                   &mt GRAVE MINUS    &kp ENTER                                                 &to 2
            >;
        };

        mouse_layer {
            display-name = "Mouse";
            sensor-bindings = <&scroll_down_up>;
            bindings = <
&trans  &trans  &trans  &trans     &trans     &trans            &trans  &trans  &trans  &trans            &trans  &trans           &trans          &trans       &trans  &trans
&trans  &trans  &trans  &trans     &trans     &trans            &trans  &trans  &trans  &trans            &trans  &kp LS(LC(TAB))  &mkp MCLK       &kp LC(TAB)  &trans  &trans
&trans  &trans  &trans  &mkp MCLK  &mkp LCLK  &trans  &trans    &trans  &trans  &trans  &trans    &trans  &trans  &mkp LCLK        &msc SCRL_UP    &mkp RCLK    &trans  &trans
&trans  &trans  &trans  &trans     &trans     &trans  &trans    &trans  &trans  &trans  &trans    &trans  &trans  &mkp MB4         &msc SCRL_DOWN  &mkp MB5     &trans  &trans
&trans  &trans          &trans     &trans     &trans  &trans                                      &trans  &trans                                                        &to 0
            >;
        };

        game {
            bindings = <
&trans     &trans     &trans  &trans  &trans  &trans                &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans    &trans          &trans
&trans     &trans     &trans  &trans  &trans  &trans                &trans  &trans  &trans  &trans            &trans  &trans  &trans  &trans    &trans          &trans
&trans     &kp A      &kp S   &kp D   &kp F   &kp G      &kp ESC    &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans    &kp UP_ARROW    &trans
&kp LSHFT  &kp LSHFT  &kp Z   &kp X   &kp C   &kp V      &kp B      &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &kp LEFT  &kp DOWN_ARROW  &kp RIGHT
&trans     &trans             &trans  &trans  &kp SPACE  &trans                                       &trans  &trans                                            &to 0
            >;

            sensor-bindings = <&scroll_down_up>;
        };

        lower_layer {
            display-name = "Lower";
            sensor-bindings = <&inc_dec_kp C_VOLUME_DOWN C_VOL_UP>;
            bindings = <
&kp F1    &kp F2          &kp F3     &kp F4      &kp F5         &kp F6                               &trans  &trans  &trans  &trans                     &kp F7        &kp F8              &kp F9          &kp F10        &kp F11        &kp F12
&kp HOME  &kp LS(LC(F6))  &kp LC(W)  &kp ESCAPE  &kp LC(LS(T))  &kp LC(LS(TAB))                      &trans  &trans  &trans  &trans                     &kp A         &kp LC(LEFT_ARROW)  &kp UP_ARROW    &kp LC(RIGHT)  &kp PG_UP      &msc SCRL_UP
&kp END   &kp LC(A)       &kp LC(S)  &kp DEL     &kp F2         &kp LC(TAB)      &kp C_PLAY_PAUSE    &trans  &trans  &trans  &trans    &kp PRINTSCREEN  &kp C_VOL_UP  &kp LEFT            &kp DOWN_ARROW  &kp RIGHT      &kp PAGE_DOWN  &msc SCRL_DOWN
&trans    &trans          &kp LC(Z)  &kp LC(X)   &kp LC(C)      &kp LC(V)        &trans              &trans  &trans  &trans  &trans    &kp NON_US_HASH  &kp C_VOL_DN  &mkp MB1            &kp LA(LEFT)    &kp LA(RIGHT)  &kp KP_PLUS    &kp LS(INTERNATIONAL_3)
&mo 2     &trans                     &trans      &trans         &trans           &trans                                                &trans           &trans                                                                          &mo 1
            >;
        };

        adjust_layer {
            display-name = "Adjust";
            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>;
            bindings = <
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4            &trans  &trans  &trans  &trans              &bt BT_CLR_ALL  &none  &none  &none  &none  &none
&trans  &none         &none         &none         &none         &none                   &trans  &trans  &trans  &trans              &bt BT_CLR      &none  &none  &none  &none  &none
&trans  &none         &none         &none         &none         &none         &none     &trans  &trans  &trans  &trans    &ind_bat  &out OUT_TOG    &none  &none  &none  &none  &none
&trans  &none         &none         &none         &none         &none         &none     &trans  &trans  &trans  &trans    &ind_con  &studio_unlock  &none  &none  &none  &none  &studio_unlock
&trans  &kp C_MUTE                  &trans        &trans        &trans        &trans                                      &trans    &kp DEL                                     &trans
            >;
        };

        // Extra layer can be added in ZMK STUDIO
    };
};
